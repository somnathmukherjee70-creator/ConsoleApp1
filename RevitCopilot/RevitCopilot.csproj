<Project Sdk="Microsoft.NET.Sdk">

  <!-- Build for a Revit version with:  dotnet build -p:RevitVersion=2026
       Revit 2027 runs add-ins on .NET 10, Revit 2026 on .NET 8. Revit 2025 and older are not supported:
       the Anthropic SDK needs System.Text.Json 10, which only loads there with 2026+ add-in isolation. -->
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2027</RevitVersion>
    <TargetFramework Condition="'$(RevitVersion)' &gt;= '2027'">net10.0-windows</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' &lt; '2027'">net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Revit loads the add-in from a folder, so NuGet dependencies must sit next to RevitCopilot.dll. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.57.0" />
    <!-- Reference-only copies of RevitAPI.dll / RevitAPIUI.dll; Revit supplies the real ones at runtime. -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <None Update="RevitCopilot.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- On Windows, install the build output into Revit's add-in folder so Revit picks it up on next start. -->
  <Target Name="DeployToRevit" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <PropertyGroup>
      <AddinRoot>$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)</AddinRoot>
    </PropertyGroup>
    <ItemGroup>
      <CopilotFiles Include="$(OutDir)**\*.*" Exclude="$(OutDir)RevitCopilot.addin" />
    </ItemGroup>
    <Copy SourceFiles="$(OutDir)RevitCopilot.addin" DestinationFolder="$(AddinRoot)" />
    <Copy SourceFiles="@(CopilotFiles)" DestinationFolder="$(AddinRoot)\RevitCopilot\%(RecursiveDir)" />
  </Target>

</Project>
